# $BASTION engine config (bot/pons-burn-bot.ts), Robinhood Chain 4663
# Copy to .env and fill CREATOR_PRIVATE_KEY + ADMIN_SECRET.
TOKEN_ADDRESS=""
CURVE_ADDRESS=""
TREASURY_ADDRESS=""
RPC_URL="https://rpc.mainnet.chain.robinhood.com"
POLL_INTERVAL_SECONDS=10

# Key of the BASTION creator wallet: the escrow pays fees to whoever calls claim(),
# so this must be the wallet the fees accrue to (the old engine used 0x789A2b5b...04a9).
CREATOR_PRIVATE_KEY=""

# Needed to change token/treasury over POST /api/config (the key is .env only) (header x-admin-secret). Empty = disabled.
ADMIN_SECRET=""

# ── How the fees are used (split mode, the default) ──
# Every claim is split on the spot: BURN_SHARE_PCT % becomes the burn budget, the rest is the dev's wages
# (sent to TREASURY_ADDRESS). The website shows this split, so pick it and stand by it.
CYCLE_MODE=split
BURN_SHARE_PCT=35
# The escrow is claimed once it holds this much
CLAIM_THRESHOLD_ETH=0.01
# The burn budget is spent in buys of at most MAX_BUY_ETH, BUY_SPACING_SECONDS apart
MAX_BUY_ETH=0.01
MIN_BUY_ETH=0.001
BUY_SPACING_SECONDS=90
# A buy reverts instead of filling more than this far below the quote (300 = 3%)
SLIPPAGE_BPS=300
# The operator wallet never spends below this (gas money)
GAS_RESERVE_ETH=0.002

# How often (seconds) the bot sweeps the curve's fees into the escrow while it is below the threshold
SWEEP_INTERVAL_SECONDS=120

PORT=5015
HOST=127.0.0.1
# Serve the built site (npm run build) from the same port
SITE_DIR="./dist"
